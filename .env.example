# Kopiraj u .env (koren repoa) i popuni.

ENV=development
# Postgres iz docker-compose.yml (port 5433, da ne smeta bazi Kafeterija Portala)
DATABASE_URL=postgresql+psycopg://zrno:zrno_dev@127.0.0.1:5433/zrno

# Dug nasumičan string; u produkciji obavezno drugačiji:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zameni-me-dugim-nasumicnim-stringom
# true u produkciji (HTTPS)
COOKIE_SECURE=false

# javna adresa aplikacije; od nje se prave pozivni linkovi za polaznike
APP_URL=http://localhost:3000

# lozinka za naloge osoblja iz seed.py (samo lokalni razvoj, najmanje 10 znakova)
SEED_LOZINKA=lozinka-za-razvoj

# frontend (Next.js) čita ove dve
BACKEND_URL=http://localhost:8000
SESSION_COOKIE=zpz_session
